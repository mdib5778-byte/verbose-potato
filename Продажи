"use client";

import { useState } from "react";

interface Employee {
  id: string;
  name: string;
  email: string;
}

interface Target {
  id: string;
  targetAmount: number;
  achievedAmount: number;
  user: Employee;
}

interface Plan {
  id: string;
  totalTarget: number;
  totalRemaining: number;
  employeeTargets: Target[];
}

interface DistributePlanModalProps {
  isOpen: boolean;
  onClose: () => void;
  onPlanDistributed: (plan: any) => void;
  plan: Plan;
  employees: Employee[];
}

export default function DistributePlanModal({
  isOpen,
  onClose,
  onPlanDistributed,
  plan,
  employees,
}: DistributePlanModalProps) {
  const [targets, setTargets] = useState<Record<string, number>>(
    plan.employeeTargets.reduce((acc, target) => {
      acc[target.user.id] = target.targetAmount;
      return acc;
    }, {} as Record<string, number>)
  );
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState("");

  const totalAllocated = Object.values(targets).reduce((sum, val) => sum + val, 0);
  const remaining = plan.totalTarget - totalAllocated;

  const handleTargetChange = (userId: string, value: string) => {
    const numValue = parseFloat(value) || 0;
    setTargets((prev) => ({
      ...prev,
      [userId]: numValue,
    }));
  };

  const handleDistributeEqually = () => {
    const equalShare = plan.totalTarget / employees.length;
    const newTargets: Record<string, number> = {};
    employees.forEach((emp) => {
      newTargets[emp.id] = equalShare;
    });
    setTargets(newTargets);
  };

  const handleDistributeProportionally = () => {
    const currentTotal = totalAllocated;
    if (currentTotal === 0) {
      handleDistributeEqually();
      return;
    }

    const ratio = plan.totalTarget / currentTotal;
    const newTargets: Record<string, number> = {};
    employees.forEach((emp) => {
      const current = targets[emp.id] || 0;
      newTargets[emp.id] = Math.round(current * ratio * 100) / 100;
    });
    setTargets(newTargets);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    
    if (totalAllocated > plan.totalTarget) {
      setError(`Сумма планов сотрудников (${totalAllocated}) превышает общий план (${plan.totalTarget})`);
      return;
    }

    setIsLoading(true);
    setError("");

    try {
      const res = await fetch(`/api/plans/${plan.id}/distribute`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ targets }),
      });

      if (res.ok) {
        const updatedPlan = await res.json();
        onPlanDistributed(updatedPlan);
      } else {
        const data = await res.json();
        setError(data.message || "Ошибка при распределении плана");
      }
    } catch (error) {
      setError("Произошла ошибка при распределении плана");
    } finally {
      setIsLoading(false);
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div className="bg-white rounded-lg p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <h2 className="text-xl font-bold mb-4">Распределение плана</h2>
        
        <div className="mb-4 p-4 bg-gray-50 rounded-lg">
          <div className="grid grid-cols-2 gap-4">
            <div>
              <span className="text-sm text-gray-500">Общий план:</span>
              <p className="text-lg font-bold">{plan.totalTarget.toLocaleString()} ₽</p>
            </div>
            <div>
              <span className="text-sm text-gray-500">Распределено:</span>
              <p className={`text-lg font-bold ${remaining < 0 ? 'text-red-600' : ''}`}>
                {totalAllocated.toLocaleString()} ₽
              </p>
            </div>
            <div>
              <span className="text-sm text-gray-500">Остаток:</span>
              <p className={`text-lg font-bold ${remaining < 0 ? 'text-red-600' : ''}`}>
                {remaining.toLocaleString()} ₽
              </p>
            </div>
          </div>
        </div>

        <div className="mb-4 flex space-x-2">
          <button
            type="button"
            onClick={handleDistributeEqually}
            className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200"
          >
            Распределить поровну
          </button>
          <button
            type="button"
            onClick={handleDistributeProportionally}
            className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200"
          >
            Пропорционально текущему
          </button>
        </div>

        <form onSubmit={handleSubmit}>
          <div className="space-y-4 mb-6">
            {employees.map((employee) => (
              <div key={employee.id} className="flex items-center space-x-4">
                <div className="flex-1">
                  <label className="block text-sm font-medium text-gray-700">
                    {employee.name}
                  </label>
                  <input
                    type="number"
                    value={targets[employee.id] || 0}
                    onChange={(e) => handleTargetChange(employee.id, e.target.value)}
                    min="0"
                    step="0.01"
                    className="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
                <div className="w-32 text-right text-sm text-gray-500">
                  {plan.employeeTargets.find(t => t.user.id === employee.id)?.achievedAmount.toLocaleString() || 0} ₽
                </div>
              </div>
            ))}
          </div>

          {error && (
            <div className="mb-4 text-red-600 text-sm">{error}</div>
          )}

          <div className="flex justify-end space-x-3">
            <button
              type="button"
              onClick={onClose}
              className="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
            >
              Отмена
            </button>
            <button
              type="submit"
              disabled={isLoading || remaining < 0}
              className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50"
            >
              {isLoading ? "Сохранение..." : "Сохранить"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
