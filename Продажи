// app/api/register/route.ts
import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import bcrypt from "bcryptjs";

export async function POST(request: Request) {
  try {
    const { name, email, password } = await request.json();

    if (!name || !email || !password) {
      return NextResponse.json(
        { message: "Все поля обязательны" },
        { status: 400 }
      );
    }

    const existingUser = await prisma.user.findUnique({
      where: { email },
    });

    if (existingUser) {
      return NextResponse.json(
        { message: "Пользователь с таким email уже существует" },
        { status: 400 }
      );
    }

    const hashedPassword = await bcrypt.hash(password, 10);

    const user = await prisma.user.create({
      data: {
        name,
        email,
        password: hashedPassword,
        role: "EMPLOYEE", // По умолчанию все новые пользователи - сотрудники
      },
    });

    return NextResponse.json(
      { message: "Пользователь успешно создан", userId: user.id },
      { status: 201 }
    );
  } catch (error) {
    console.error("Registration error:", error);
    return NextResponse.json(
      { message: "Внутренняя ошибка сервера" },
      { status: 500 }
    );
  }
}
// app/api/plans/route.ts
import { NextResponse } from "next/server";
import { getServerSession } from "next-auth";
import { authOptions } from "@/lib/auth";
import { prisma } from "@/lib/prisma";

export async function POST(request: Request) {
  try {
    const session = await getServerSession(authOptions);

    if (!session || session.user.role !== "ADMIN") {
      return NextResponse.json(
        { message: "Недостаточно прав" },
        { status: 403 }
      );
    }

    const { monthYear, totalTarget } = await request.json();

    if (!monthYear || !totalTarget) {
      return NextResponse.json(
        { message: "Все поля обязательны" },
        { status: 400 }
      );
    }

    // Проверяем, нет ли уже плана на этот месяц
    const existingPlan = await prisma.monthlyPlan.findFirst({
      where: { monthYear },
    });

    if (existingPlan) {
      return NextResponse.json(
        { message: "План на этот месяц уже существует" },
        { status: 400 }
      );
    }

    // Создаем новый план
    const plan = await prisma.monthlyPlan.create({
      data: {
        monthYear,
        totalTarget,
        totalRemaining: totalTarget,
      },
      include: {
        employeeTargets: {
          include: {
            user: true,
          },
        },
      },
    });

    // Получаем всех сотрудников
    const employees = await prisma.user.findMany({
      where: { role: "EMPLOYEE" },
    });

    // Создаем цели для каждого сотрудника с начальным значением 0
    if (employees.length > 0) {
      await prisma.employeeTarget.createMany({
        data: employees.map((emp) => ({
          planId: plan.id,
          userId: emp.id,
          targetAmount: 0,
          achievedAmount: 0,
          status: "NOT_COMPLETED",
        })),
      });
    }

    // Получаем обновленный план с целями
    const updatedPlan = await prisma.monthlyPlan.findUnique({
      where: { id: plan.id },
      include: {
        employeeTargets: {
          include: {
            user: true,
          },
        },
      },
    });

    return NextResponse.json(updatedPlan, { status: 201 });
  } catch (error) {
    console.error("Create plan error:", error);
    return NextResponse.json(
      { message: "Внутренняя ошибка сервера" },
      { status: 500 }
    );
  }
}
// app/api/plans/[planId]/distribute/route.ts
import { NextResponse } from "next/server";
import { getServerSession } from "next-auth";
import { authOptions } from "@/lib/auth";
import { prisma } from "@/lib/prisma";
import { calculateStatus } from "@/lib/utils";

export async function POST(
  request: Request,
  { params }: { params: { planId: string } }
) {
  try {
    const session = await getServerSession(authOptions);

    if (!session || session.user.role !== "ADMIN") {
      return NextResponse.json(
        { message: "Недостаточно прав" },
        { status: 403 }
      );
    }

    const { planId } = params;
    const { targets } = await request.json();

    if (!targets) {
      return NextResponse.json(
        { message: "Данные целей обязательны" },
        { status: 400 }
      );
    }

    // Получаем план
    const plan = await prisma.monthlyPlan.findUnique({
      where: { id: planId },
      include: {
        employeeTargets: true,
      },
    });

    if (!plan) {
      return NextResponse.json(
        { message: "План не найден" },
        { status: 404 }
      );
    }

    // Проверяем сумму целей
    const totalTargets = Object.values(targets).reduce((sum: number, val: any) => sum + val, 0);
    if (totalTargets > plan.totalTarget) {
      return NextResponse.json(
        { message: "Сумма целей превышает общий план" },
        { status: 400 }
      );
    }

    // Обновляем цели сотрудников
    for (const target of plan.employeeTargets) {
      const newTargetAmount = targets[target.userId] || 0;
      
      await prisma.employeeTarget.update({
        where: { id: target.id },
        data: {
          targetAmount: newTargetAmount,
          status: calculateStatus(target.achievedAmount, newTargetAmount),
        },
      });
    }

    // Получаем обновленный план
    const updatedPlan = await prisma.monthlyPlan.findUnique({
      where: { id: planId },
      include: {
        employeeTargets: {
          include: {
            user: true,
          },
        },
      },
    });

    return NextResponse.json(updatedPlan);
  } catch (error) {
    console.error("Distribute plan error:", error);
    return NextResponse.json(
      { message: "Внутренняя ошибка сервера" },
      { status: 500 }
    );
  }
}
