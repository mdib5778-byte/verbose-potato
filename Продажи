// lib/utils.ts
import { type ClassValue, clsx } from "clsx"
import { twMerge } from "tailwind-merge"

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs))
}

export function getStatusColor(status: string) {
  switch (status) {
    case 'IN_PROGRESS':
      return 'bg-yellow-100 text-yellow-800'
    case 'GOOD':
      return 'bg-green-100 text-green-800'
    case 'OVERFULFILLED':
      return 'bg-blue-100 text-blue-800'
    case 'NOT_COMPLETED':
      return 'bg-red-100 text-red-800'
    default:
      return 'bg-gray-100 text-gray-800'
  }
}

export function getStatusText(status: string) {
  switch (status) {
    case 'IN_PROGRESS':
      return 'В работе'
    case 'GOOD':
      return 'Хорошо'
    case 'OVERFULFILLED':
      return 'Перевыполнен'
    case 'NOT_COMPLETED':
      return 'Не выполнен'
    default:
      return status
  }
}

export function calculateProgress(achieved: number, target: number): number {
  if (target === 0) return 0
  return Math.min(Math.round((achieved / target) * 100), 100)
}

export function calculateStatus(achieved: number, target: number): string {
  if (target === 0) return 'NOT_COMPLETED'
  const percentage = (achieved / target) * 100
  
  if (percentage === 0) return 'NOT_COMPLETED'
  if (percentage < 50) return 'IN_PROGRESS'
  if (percentage < 90) return 'GOOD'
  return 'OVERFULFILLED'
}
