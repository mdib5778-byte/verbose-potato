// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(EMPLOYEE)
  createdAt       DateTime         @default(now()) @map("created_at")
  employeeTargets EmployeeTarget[]
  sales           Sale[]

  @@map("users")
}

model MonthlyPlan {
  id              String           @id @default(cuid())
  monthYear       String           @map("month_year")
  totalTarget     Float            @map("total_target")
  totalRemaining  Float            @map("total_remaining")
  createdAt       DateTime         @default(now()) @map("created_at")
  employeeTargets EmployeeTarget[]
  sales           Sale[]

  @@map("monthly_plans")
}

model EmployeeTarget {
  id              String       @id @default(cuid())
  planId          String       @map("plan_id")
  userId          String       @map("user_id")
  targetAmount    Float        @map("target_amount")
  achievedAmount  Float        @default(0) @map("achieved_amount")
  status          TargetStatus @default(IN_PROGRESS)
  plan            MonthlyPlan  @relation(fields: [planId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@unique([planId, userId])
  @@map("employee_targets")
}

model Sale {
  id        String       @id @default(cuid())
  planId    String       @map("plan_id")
  userId    String       @map("user_id")
  date      DateTime
  amount    Float
  comment   String?
  createdAt DateTime     @default(now()) @map("created_at")
  plan      MonthlyPlan  @relation(fields: [planId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@map("sales")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TargetStatus {
  IN_PROGRESS   // 0-50%
  GOOD          // 50-90%
  OVERFULFILLED // 90%+
  NOT_COMPLETED // 0% (после окончания месяца)
}
